@model NexusCommunicationSystem.Models.FeedbackReportViewModel
@{
    ViewData["Title"] = "Feedback Report";
    ViewData["Active"] = "Reports";
    ViewData["Tab"] = "FeedbackReport";
}

<div class="page-head">
    <div>
        <h1>Feedback Report</h1>
        <p>Customer feedback with average rating and rating distribution.</p>
    </div>
</div>

<partial name="_SearchNav" />

<div class="card mb">
    <form method="get" asp-action="FeedbackReport" class="nx-filter" data-search data-clean="true">
        <div class="form-group"><label for="fromDate">From date</label><input type="date" id="fromDate" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" /></div>
        <div class="form-group"><label for="toDate">To date</label><input type="date" id="toDate" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" /></div>
        <div class="form-group"><label for="rating">Rating</label>
            <select id="rating" name="rating">
                <option value="">All</option>
                @for (int r = 5; r >= 1; r--) { <option value="@r" selected="@(Model.Rating == r)">@r star(s)</option> }
            </select></div>
        <div class="form-group nx-filter-actions">
            <button type="submit" class="btn btn-primary"><span class="material-symbols-outlined">filter_alt</span> Generate</button>
            <a href="#" data-action="clear-search" class="btn btn-outline">Reset</a>
        </div>
    </form>
</div>

<div class="nx-kpis">
    <div class="nx-kpi"><div class="nx-kpi-top"><span class="nx-kpi-label">Feedback</span></div><div class="nx-kpi-value">@Model.Feedbacks.Count</div></div>
    <div class="nx-kpi"><div class="nx-kpi-top"><span class="nx-kpi-label">Average rating</span></div><div class="nx-kpi-value">@Model.AverageRating.ToString("0.00") <small>/ 5</small></div></div>
    @for (int r = 5; r >= 1; r--)
    {
        <div class="nx-kpi"><div class="nx-kpi-top"><span class="nx-kpi-label">@r star(s)</span></div><div class="nx-kpi-value">@Model.Distribution[r]</div></div>
    }
</div>

<div class="card">
<div class="toolbar">
    <input type="text" id="quickFilter" class="form-control" style="max-width:300px" placeholder="Quick filter this table..." />
    <div class="actions no-print">
        <a href="#" data-action="export-csv" data-filename="feedback-report" class="btn btn-outline btn-sm"><span class="material-symbols-outlined">download</span> Export CSV</a>
        <a href="#" data-action="print" class="btn btn-outline btn-sm"><span class="material-symbols-outlined">print</span> Print</a>
    </div>
</div>
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>Customer</th><th>Date</th><th>Rating</th><th>Subject</th><th>Message</th></tr></thead>
            <tbody>
            @foreach (var f in Model.Feedbacks)
            {
                <tr><td>@f.Customer?.FullName</td><td>@f.CreatedAt.ToString("dd MMM yyyy")</td><td><span class="stars">@(new string('★', f.Rating))@(new string('☆', 5 - f.Rating))</span></td><td><strong>@f.Subject</strong></td><td>@f.Message</td></tr>
            }
            @if (!Model.Feedbacks.Any())
            {
                <tr><td colspan="5" class="empty">No feedback in this period.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<script src="~/js/search.js" asp-append-version="true"></script>
