@model NexusCommunicationSystem.Models.BillingReportViewModel
@{
    ViewData["Title"] = "Billing Report";
    ViewData["Active"] = "Reports";
    ViewData["Tab"] = "BillingReport";
}

<div class="page-head">
    <div>
        <h1>Billing Report</h1>
        <p>Bills in a period with billed, paid and outstanding totals.</p>
    </div>
</div>

<partial name="_SearchNav" />

<div class="card mb">
    <form method="get" asp-action="BillingReport" class="nx-filter" data-search data-clean="true">
        <div class="form-group"><label for="fromDate">From date</label><input type="date" id="fromDate" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" /></div>
        <div class="form-group"><label for="toDate">To date</label><input type="date" id="toDate" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" /></div>
        <div class="form-group"><label for="paidStatus">Bill status</label>
            <select id="paidStatus" name="paidStatus">
                <option value="">All</option>
                @foreach (var s in new[] { "Paid", "Partial", "Unpaid" }) { <option value="@s" selected="@(Model.PaidStatus == s)">@s</option> }
            </select></div>
        <div class="form-group nx-filter-actions">
            <button type="submit" class="btn btn-primary"><span class="material-symbols-outlined">filter_alt</span> Generate</button>
            <a href="#" data-action="clear-search" class="btn btn-outline">Reset</a>
        </div>
    </form>
</div>

<div class="nx-kpis">
    <div class="nx-kpi"><div class="nx-kpi-top"><span class="nx-kpi-label">Bills</span></div><div class="nx-kpi-value">@Model.Bills.Count</div></div>
    <div class="nx-kpi"><div class="nx-kpi-top"><span class="nx-kpi-label">Total billed</span></div><div class="nx-kpi-value"><small>$</small> @Model.TotalBilled.ToString("N0")</div></div>
    <div class="nx-kpi"><div class="nx-kpi-top"><span class="nx-kpi-label">Collected</span></div><div class="nx-kpi-value"><small>$</small> @Model.TotalPaid.ToString("N0")</div></div>
    <div class="nx-kpi"><div class="nx-kpi-top"><span class="nx-kpi-label">Outstanding</span></div><div class="nx-kpi-value"><small>$</small> @Model.TotalUnpaid.ToString("N0")</div></div>
</div>

<div class="card">
<div class="toolbar">
    <input type="text" id="quickFilter" class="form-control" style="max-width:300px" placeholder="Quick filter this table..." />
    <div class="actions no-print">
        <a href="#" data-action="export-csv" data-filename="billing-report" class="btn btn-outline btn-sm"><span class="material-symbols-outlined">download</span> Export CSV</a>
        <a href="#" data-action="print" class="btn btn-outline btn-sm"><span class="material-symbols-outlined">print</span> Print</a>
    </div>
</div>
<div class="table-wrap">
    <table class="table">
        <thead><tr><th>Bill #</th><th>Customer</th><th>Month</th><th>Bill Date</th><th>Due Date</th><th>Status</th><th style="text-align:right">Total ($)</th></tr></thead>
        <tbody>
        @foreach (var b in Model.Bills)
        {
            <tr>
                <td>@b.BillId</td><td>@b.Customer?.FullName</td><td>@b.BillingMonth</td>
                <td>@b.BillDate.ToString("dd MMM yyyy")</td><td>@b.DueDate.ToString("dd MMM yyyy")</td>
                <td><span class="badge b-@((b.Status ?? "").ToLower())">@b.Status</span></td>
                <td style="text-align:right">@b.TotalAmount.ToString("N0")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
    @if (!Model.Bills.Any()) { <div class="empty">No bills in this period.</div> }
</div>

<script src="~/js/search.js" asp-append-version="true"></script>
