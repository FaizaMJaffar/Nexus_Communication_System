@model NexusCommunicationSystem.Models.PaymentReportViewModel
@{
    ViewData["Title"] = "Payment Report";
    ViewData["Active"] = "Reports";
    ViewData["Tab"] = "PaymentReport";
}

<div class="page-head">
    <div>
        <h1>Payment Report</h1>
        <p>Payments received in a period, grouped by method.</p>
    </div>
</div>

<partial name="_SearchNav" />

<div class="card mb">
    <form method="get" asp-action="PaymentReport" class="nx-filter" data-search data-clean="true">
        <div class="form-group"><label for="fromDate">From date</label><input type="date" id="fromDate" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" /></div>
        <div class="form-group"><label for="toDate">To date</label><input type="date" id="toDate" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" /></div>
        <div class="form-group"><label for="method">Method</label>
            <select id="method" name="method">
                <option value="">All</option>
                @foreach (var m in new[] { "Cash", "Card", "Bank Transfer" }) { <option value="@m" selected="@(Model.Method == m)">@m</option> }
            </select></div>
        <div class="form-group nx-filter-actions">
            <button type="submit" class="btn btn-primary"><span class="material-symbols-outlined">filter_alt</span> Generate</button>
            <a href="#" data-action="clear-search" class="btn btn-outline">Reset</a>
        </div>
    </form>
</div>

<div class="nx-kpis">
    <div class="nx-kpi"><div class="nx-kpi-top"><span class="nx-kpi-label">Payments</span></div><div class="nx-kpi-value">@Model.Payments.Count</div></div>
    <div class="nx-kpi"><div class="nx-kpi-top"><span class="nx-kpi-label">Total collected</span></div><div class="nx-kpi-value"><small>$</small> @Model.TotalCollected.ToString("N0")</div></div>
    @foreach (var m in Model.ByMethod)
    {
        <div class="nx-kpi"><div class="nx-kpi-top"><span class="nx-kpi-label">@m.Method</span></div><div class="nx-kpi-value"><small>$</small> @m.Total.ToString("N0")</div><div class="nx-kpi-note">@m.Count payment(s)</div></div>
    }
</div>

<div class="card">
<div class="toolbar">
    <input type="text" id="quickFilter" class="form-control" style="max-width:300px" placeholder="Quick filter this table..." />
    <div class="actions no-print">
        <a href="#" data-action="export-csv" data-filename="payment-report" class="btn btn-outline btn-sm"><span class="material-symbols-outlined">download</span> Export CSV</a>
        <a href="#" data-action="print" class="btn btn-outline btn-sm"><span class="material-symbols-outlined">print</span> Print</a>
    </div>
</div>
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>Payment #</th><th>Bill #</th><th>Customer</th><th>Date</th><th>Method</th><th>Reference</th><th style="text-align:right">Amount ($)</th></tr></thead>
            <tbody>
            @foreach (var p in Model.Payments)
            {
                <tr><td>@p.PaymentId</td><td>@p.BillId</td><td>@p.Bill?.Customer?.FullName</td><td>@p.PaymentDate.ToString("dd MMM yyyy")</td><td>@p.PaymentMethod</td><td>@p.ReferenceNo</td><td style="text-align:right">@p.AmountPaid.ToString("N0")</td></tr>
            }
            @if (!Model.Payments.Any())
            {
                <tr><td colspan="7" class="empty">No payments in this period.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<script src="~/js/search.js" asp-append-version="true"></script>
