@model List<Plan>
@{
    ViewData["Title"] = "Plans";
    ViewData["Active"] = "Plans";
}

<div class="page-head">
    <div>
        <h1>Plans</h1>
        <p>Manage the plans customers can choose from.</p>
    </div>
    <a asp-action="AddPlan" class="btn btn-primary">+ Add plan</a>
</div>

<div class="card">
    <div class="toolbar">
        <form asp-action="Plans" method="get" class="search-form">
            <input type="text" name="q" value="@ViewBag.Q" class="form-control" placeholder="Search..." />
            <button type="submit" class="btn btn-primary">Search</button>
            @if (!string.IsNullOrEmpty(ViewBag.Q as string))
            {
                <a asp-action="Plans" class="btn btn-outline">Clear</a>
            }
        </form>
        <span class="count-chip">@Model.Count record(s)</span>
    </div>
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>#</th><th>Plan Name</th><th>Plan Type</th><th>Connection</th><th>Speed</th><th>Price</th><th>Data (GB)</th><th>Validity (Days)</th><th>Status</th><th class="th-actions">Actions</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.PlanName</td>
                    <td>@item.PlanType</td>
                    <td>@item.ConnectionType</td>
                    <td>@item.Speed</td>
                    <td>@item.Price.ToString("N0")</td>
                    <td>@item.DataGB</td>
                    <td>@item.ValidityDays</td>
                    <td><span class="badge @(item.IsActive ? "badge-green" : "badge-red")">@(item.IsActive ? "Active" : "Inactive")</span></td>
                    <td class="actions">
                        <a asp-action="EditPlan" asp-route-id="@item.Id" class="btn btn-sm btn-outline">Edit</a>
                        <form asp-action="DeletePlan" asp-route-id="@item.Id" method="post" class="inline" data-confirm="Delete this plan? This cannot be undone.">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="10" class="empty">Nothing here yet. Use the add button to create a record.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
