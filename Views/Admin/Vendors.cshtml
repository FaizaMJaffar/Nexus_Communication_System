@model List<Vendor>
@{
    ViewData["Title"] = "Vendors";
    ViewData["Active"] = "Vendors";
}

<div class="page-head">
    <div>
        <h1>Vendors</h1>
        <p>Manage vendors who supply equipment.</p>
    </div>
    <a asp-action="AddVendor" class="btn btn-primary">+ Add vendor</a>
</div>

<div class="card">
    <div class="toolbar">
        <form asp-action="Vendors" method="get" class="search-form">
            <input type="text" name="q" value="@ViewBag.Q" class="form-control" placeholder="Search..." />
            <button type="submit" class="btn btn-primary">Search</button>
            @if (!string.IsNullOrEmpty(ViewBag.Q as string))
            {
                <a asp-action="Vendors" class="btn btn-outline">Clear</a>
            }
        </form>
        <span class="count-chip">@Model.Count record(s)</span>
    </div>
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>#</th><th>Vendor Name</th><th>Contact Person</th><th>Email</th><th>Phone</th><th>Address</th><th>Status</th><th class="th-actions">Actions</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.VendorName</td>
                    <td>@item.ContactPerson</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>@item.Address</td>
                    <td><span class="badge @(item.IsActive ? "badge-green" : "badge-red")">@(item.IsActive ? "Active" : "Inactive")</span></td>
                    <td class="actions">
                        <a asp-action="EditVendor" asp-route-id="@item.Id" class="btn btn-sm btn-outline">Edit</a>
                        <form asp-action="DeleteVendor" asp-route-id="@item.Id" method="post" class="inline" data-confirm="Delete this vendor? This cannot be undone.">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="8" class="empty">Nothing here yet. Use the add button to create a record.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
