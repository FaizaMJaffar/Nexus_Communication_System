@model Vendor
@{
    ViewData["Title"] = "Edit Vendor";
    ViewData["Active"] = "Vendors";
}

<div class="page-head">
    <div>
        <h1>Edit Vendor</h1>
        <p>Update the details below and save.</p>
    </div>
    <a asp-action="Vendors" class="btn btn-outline">Back to list</a>
</div>

<div class="card">
<form asp-action="EditVendor" method="post" class="form-grid">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger form-full"></div>
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="VendorName">Vendor Name <span class="req">*</span></label>
        <input asp-for="VendorName" type="text" class="form-control" required />
        <span asp-validation-for="VendorName" class="field-error"></span>
    </div>
    <div class="form-group">
        <label asp-for="ContactPerson">Contact Person <span class="req">*</span></label>
        <input asp-for="ContactPerson" type="text" class="form-control" required />
        <span asp-validation-for="ContactPerson" class="field-error"></span>
    </div>
    <div class="form-group">
        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" class="form-control" />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>
    <div class="form-group">
        <label asp-for="Phone">Phone <span class="req">*</span></label>
        <input asp-for="Phone" type="tel" class="form-control" required />
        <span asp-validation-for="Phone" class="field-error"></span>
    </div>
    <div class="form-group form-full">
        <label asp-for="Address">Address</label>
        <textarea asp-for="Address" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Address" class="field-error"></span>
    </div>
    <div class="form-group form-full">
        <label class="check-row"><input asp-for="IsActive" type="checkbox" /> Active</label>
    </div>
    <div class="form-actions form-full">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-action="Vendors" class="btn btn-outline">Cancel</a>
    </div>
</form>
</div>
