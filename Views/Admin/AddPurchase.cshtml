@model PurchaseOrder
@{
    ViewData["Title"] = "New Purchase";
    ViewData["Active"] = "PurchaseList";
}

<div class="page-head">
    <div>
        <h1>New Purchase</h1>
        <p>Order equipment from a vendor. Link it to a customer order if it is needed for one.</p>
    </div>
    <a asp-action="PurchaseList" class="btn btn-outline">Back to list</a>
</div>

<div class="card">
<form asp-action="AddPurchase" method="post" class="form-grid">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger form-full"></div>
    <div class="form-group">
        <label asp-for="VendorId">Vendor <span class="req">*</span></label>
        <select asp-for="VendorId" asp-items="(SelectList)ViewBag.Vendors" class="form-control" required><option value="">-- Select vendor --</option></select>
        <span asp-validation-for="VendorId" class="field-error"></span>
    </div>
    <div class="form-group">
        <label asp-for="CustomerOrderId">For customer order</label>
        <select asp-for="CustomerOrderId" asp-items="(List<SelectListItem>)ViewBag.CustomerOrders" class="form-control"><option value="">-- Not for a specific order --</option></select>
        <span asp-validation-for="CustomerOrderId" class="field-error"></span>
    </div>
    <div class="form-group">
        <label asp-for="EquipmentName">Equipment Name <span class="req">*</span></label>
        <input asp-for="EquipmentName" type="text" class="form-control" required />
        <span asp-validation-for="EquipmentName" class="field-error"></span>
    </div>
    <div class="form-group">
        <label asp-for="EquipmentType">Equipment Type <span class="req">*</span></label>
        <input asp-for="EquipmentType" type="text" class="form-control" placeholder="e.g. Modem, Router, Telephone set" required />
        <span asp-validation-for="EquipmentType" class="field-error"></span>
    </div>
    <div class="form-group">
        <label asp-for="Quantity">Quantity <span class="req">*</span></label>
        <input asp-for="Quantity" type="number" class="form-control" min="1" required />
        <span asp-validation-for="Quantity" class="field-error"></span>
    </div>
    <div class="form-group">
        <label asp-for="UnitPrice">Unit Price ($) <span class="req">*</span></label>
        <input asp-for="UnitPrice" type="number" class="form-control" step="0.01" min="0" required />
        <span asp-validation-for="UnitPrice" class="field-error"></span>
    </div>
    <div class="form-group">
        <label asp-for="OrderDate">Order Date</label>
        <input asp-for="OrderDate" type="date" class="form-control" />
        <span asp-validation-for="OrderDate" class="field-error"></span>
    </div>
    <div class="form-group">
        <label asp-for="ExpectedDate">Expected Delivery</label>
        <input asp-for="ExpectedDate" type="date" class="form-control" />
        <span asp-validation-for="ExpectedDate" class="field-error"></span>
    </div>
    <div class="form-group form-full">
        <label asp-for="Notes">Notes</label>
        <input asp-for="Notes" type="text" class="form-control" />
        <span asp-validation-for="Notes" class="field-error"></span>
    </div>
    <div class="form-actions form-full">
        <button type="submit" class="btn btn-primary">Save purchase</button>
        <a asp-action="PurchaseList" class="btn btn-outline">Cancel</a>
    </div>
</form>
</div>
