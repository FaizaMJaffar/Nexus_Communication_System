@model List<Connection>
@{
    ViewData["Title"] = "Connections";
    ViewData["Active"] = "Connections";
}

@if (TempData["Error"] != null)
{
    <div class="tx-alert tx-alert-error">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="tx-alert tx-alert-success">@TempData["Success"]</div>
}

<div class="tx-page-head">
    <div>
        <div class="tx-breadcrumb">Operations / <span class="current">Connections & Circuits</span></div>
        <h1 class="tx-page-title">Connections & Circuits</h1>
    </div>
    <div class="tx-head-actions">
        <a class="tx-btn tx-btn-primary" asp-action="CreateConnection">New Connection</a>
    </div>
</div>

<div class="tx-card">
    <div class="tx-card-head">
        <h2 class="tx-card-title">All Connections</h2>
    </div>

    <div class="tx-table-wrap">
        <table class="tx-table">
            <thead>
                <tr>
                    <th>Account ID</th>
                    <th>Work Order</th>
                    <th>Customer</th>
                    <th>Plan</th>
                    <th>Status</th>
                    <th>Activated</th>
                    <th>Deactivated</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="8" class="tx-muted">No connections created yet.</td></tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td><span class="tx-wo">@c.ConnectionNumber</span></td>
                        <td>WO-@c.OrderId</td>
                        <td>@(c.Customer?.FullName ?? c.CustomerId.ToString())</td>
                        <td>@c.PlanName</td>
                        <td><span class="tx-badge tx-badge-@c.StatusCss">@c.Status</span></td>
                        <td>@(c.ActivatedAt == null ? "-" : string.Format("{0:dd MMM yyyy}", c.ActivatedAt))</td>
                        <td>@(c.DeactivatedAt == null ? "-" : string.Format("{0:dd MMM yyyy}", c.DeactivatedAt))</td>
                        <td>
                            @if (c.Status == "Pending" || c.Status == "Temporarily Inactive")
                            {
                                <a class="tx-btn tx-btn-primary" asp-action="ActivateConnection" asp-route-id="@c.Id">Activate</a>
                            }
                            @if (c.Status == "Active" || c.Status == "Temporarily Inactive")
                            {
                                <a class="tx-btn tx-btn-danger" asp-action="DeactivateConnection" asp-route-id="@c.Id">Make Inactive</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="tx-card-foot">Showing @Model.Count connection(s)</div>
</div>