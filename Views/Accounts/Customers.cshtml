@model List<Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="page-head">
    <div>
        <h1>Customers</h1>
        <p>Registered customers and their ids.</p>
    </div>
</div>

<table class="table table-bordered">
    <tr>
        <th>Id</th>
        <th>Full Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th>City</th>
    </tr>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Id</td>
            <td>@c.FullName</td>
            <td>@c.Email</td>
            <td>@c.Phone</td>
            <td>@c.City</td>
        </tr>
    }
</table>