@model List<Payment>

@{
    ViewData["Title"] = "Payments";
}

<div class="page-head">
    <div>
        <h1>Payments</h1>
        <p>All recorded payments.</p>
    </div>
</div>

<table class="table table-bordered">
    <tr>
        <th>Payment Id</th>
        <th>Bill Id</th>
        <th>Date</th>
        <th>Amount</th>
        <th>Method</th>
        <th>Reference</th>
    </tr>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.PaymentId</td>
            <td>@p.BillId</td>
            <td>@p.PaymentDate.ToString("dd-MM-yyyy")</td>
            <td>@p.AmountPaid</td>
            <td>@p.PaymentMethod</td>
            <td>@p.ReferenceNo</td>
        </tr>
    }
</table>