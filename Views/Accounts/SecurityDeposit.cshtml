@{
    ViewData["Title"] = "Security Deposit";
}

<div class="page-head">
    <div>
        <h1>Security Deposit</h1>
        <p>Record a security deposit against a bill.</p>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="SecurityDeposit" method="post">
    <div class="mb-3">
        <label>Bill Id</label>
        <input type="number" name="billId" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Deposit Amount</label>
        <input type="number" step="0.01" name="depositAmount" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Save Deposit</button>
</form>
