@{
    ViewData["Title"] = "Calculate Charges";
}

<div class="page-head">
    <div>
        <h1>Add Charges to Bill</h1>
        <p>Add an extra charge line to a bill.</p>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="CalculateCharges" method="post">
    <div class="mb-3">
        <label>Bill Id</label>
        <input type="number" name="billId" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Description</label>
        <input type="text" name="description" class="form-control" placeholder="Installation Fee" required />
    </div>
    <div class="mb-3">
        <label>Quantity</label>
        <input type="number" name="quantity" class="form-control" value="1" required />
    </div>
    <div class="mb-3">
        <label>Unit Price</label>
        <input type="number" step="0.01" name="unitPrice" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Add Charge</button>
</form>