@model Feedback
@{
    ViewData["Title"] = "Feedback";
    var previous = ViewBag.Previous as List<Feedback> ?? new List<Feedback>();
}

<div class="page-header">
    <div>
        <h1>Feedback</h1>
        <p>Tell us about your experience with our service</p>
    </div>
</div>

<div class="grid grid-2">
    <div class="card">
        <h3>Submit Feedback</h3>
        <form asp-action="Feedback" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-group">
                <label asp-for="Subject"></label>
                <input asp-for="Subject" type="text" placeholder="Short subject" />
                <span asp-validation-for="Subject" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Rating"></label>
                <select asp-for="Rating">
                    <option value="5">★★★★★ - Excellent</option>
                    <option value="4">★★★★☆ - Good</option>
                    <option value="3">★★★☆☆ - Average</option>
                    <option value="2">★★☆☆☆ - Poor</option>
                    <option value="1">★☆☆☆☆ - Very Poor</option>
                </select>
                <span asp-validation-for="Rating" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Message"></label>
                <textarea asp-for="Message" placeholder="Write your message here..."></textarea>
                <span asp-validation-for="Message" class="field-error"></span>
            </div>

            <button type="submit" class="btn">📨 Submit Feedback</button>
        </form>
    </div>

    <div class="card">
        <h3>Your Previous Feedback</h3>
        @if (!previous.Any())
        {
            <div class="empty">
                <span class="big">💬</span>
                You have not submitted any feedback yet.
            </div>
        }
        else
        {
            foreach (var f in previous)
            {
                <div class="feedback-item">
                    <div style="display:flex;justify-content:space-between;gap:10px">
                        <strong>@f.Subject</strong>
                        <span class="stars">@(new string('★', f.Rating))@(new string('☆', 5 - f.Rating))</span>
                    </div>
                    <p>@f.Message</p>
                    <small class="muted">@f.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</small>
                </div>
            }
        }
    </div>
</div>
