@{
    var active = ViewData["Active"] as string ?? "";
    string Act(string k) => active == k ? "active" : "";
    var uname = User.Identity?.Name ?? "Admin";
    var initials = uname.Length >= 2 ? uname.Substring(0, 2).ToUpper() : uname.ToUpper();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nexus Admin</title>
    <link rel="icon" type="image/svg+xml" href="~/images/admin/logo.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/nexus-base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="portal-admin">
<header class="nx-topbar">
    <button type="button" class="nx-menu-btn" id="nxMenuBtn" aria-label="Menu"><span class="material-symbols-outlined">menu</span></button>
    <a class="nx-brand" asp-controller="Admin" asp-action="Dashboard"><span class="material-symbols-outlined">hub</span> Nexus Telecom</a>
    <span class="nx-sub-brand">Admin Console</span>
    <div class="nx-search">
        <span class="material-symbols-outlined">search</span>
        <input type="text" placeholder="Search this page..." aria-label="Search this page" />
    </div>
    <div class="nx-top-right">
        <span class="nx-env"><i></i> Production</span>
        <span class="nx-icon-btn" title="Notifications"><span class="material-symbols-outlined">notifications</span></span>
        <span class="nx-icon-btn" title="Help"><span class="material-symbols-outlined">help</span></span>
        <div class="nx-user">
            <div class="nx-user-meta">
                <div class="nx-user-name">@(User.Identity?.Name ?? "User")</div>
                <div class="nx-user-role">Administrator</div>
            </div>
            <span class="nx-avatar">@initials</span>
            <form asp-controller="Admin" asp-action="Logout" method="post" class="inline">
                <button type="submit" class="nx-logout">Logout</button>
            </form>
        </div>
    </div>
</header>
<aside class="nx-sidebar" id="nxSidebar">
    <div class="nx-side-title"><strong>Nexus NOC Suite</strong><span>Admin Operations</span></div>
    <nav class="nx-nav">
        <a asp-controller="Admin" asp-action="Dashboard" class="@Act("Dashboard")"><span class="material-symbols-outlined">dashboard</span><span>Dashboard</span></a>
        <a asp-controller="Admin" asp-action="Employees" class="@Act("Employees")"><span class="material-symbols-outlined">groups</span><span>Employees</span></a>
        <a asp-controller="Admin" asp-action="RetailShops" class="@Act("RetailShops")"><span class="material-symbols-outlined">storefront</span><span>Retail Shops</span></a>
        <a asp-controller="Admin" asp-action="Vendors" class="@Act("Vendors")"><span class="material-symbols-outlined">local_shipping</span><span>Vendors</span></a>
        <a asp-controller="Admin" asp-action="Plans" class="@Act("Plans")"><span class="material-symbols-outlined">list_alt</span><span>Plans</span></a>
        <a asp-controller="Admin" asp-action="Equipment" class="@Act("Equipment")"><span class="material-symbols-outlined">router</span><span>Equipment</span></a>
        <a asp-controller="Admin" asp-action="PurchaseList" class="@Act("PurchaseList")"><span class="material-symbols-outlined">shopping_cart</span><span>Purchase List</span></a>
        <div class="nx-nav-label">Search &amp; Reports</div>
        <a asp-controller="Search" asp-action="Index" class="@Act("Search")"><span class="material-symbols-outlined">search</span><span>Search</span></a>
        <a asp-controller="Search" asp-action="AdvancedSearch" class="@Act("AdvancedSearch")"><span class="material-symbols-outlined">manage_search</span><span>Advanced Search</span></a>
        <a asp-controller="Search" asp-action="CustomerReport" class="@Act("Reports")"><span class="material-symbols-outlined">analytics</span><span>Reports &amp; Status</span></a>
    </nav>
    <div class="nx-side-bottom">
        <a asp-controller="Home" asp-action="Index"><span class="material-symbols-outlined">home</span><span>All portals</span></a>
        <button type="button" id="nxCollapse"><span class="material-symbols-outlined">keyboard_double_arrow_left</span><span class="nx-collapse-label">Collapse view</span></button>
    </div>
</aside>
<div class="nx-backdrop" id="nxBackdrop"></div>
<div class="nx-main">
    <div class="nx-crumbs">
        <a asp-controller="Home" asp-action="Index">Nexus</a><span class="sep">/</span><span>Admin</span><span class="sep">/</span><b>@ViewData["Title"]</b>
    </div>
    <main class="nx-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success" data-autohide>@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>
    <footer class="nx-footer"><span>&copy; @DateTime.Now.Year Nexus Communication System</span><span>Admin</span></footer>
</div>
<script src="~/js/nexus.js" asp-append-version="true"></script>
<script src="~/js/admin.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
