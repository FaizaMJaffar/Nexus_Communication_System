@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Act(params string[] names) => names.Contains(act) ? "active" : "";
    bool loggedIn = User.IsInRole("Customer");
    var uname = User.Identity?.Name ?? "Guest";
    var initials = uname.Length >= 2 ? uname.Substring(0, 2).ToUpper() : uname.ToUpper();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nexus Communication</title>
    <link rel="icon" type="image/svg+xml" href="~/images/admin/logo.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/nexus-base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />
</head>
<body class="portal-customer">
@if (loggedIn)
{
<header class="nx-topbar">
    <button type="button" class="nx-menu-btn" id="nxMenuBtn" aria-label="Menu"><span class="material-symbols-outlined">menu</span></button>
    <a class="nx-brand" asp-controller="Customer" asp-action="Dashboard"><span class="material-symbols-outlined">hub</span> Nexus Telecom</a>
    <span class="nx-sub-brand">Subscriber Portal</span>
    <div class="nx-search">
        <span class="material-symbols-outlined">search</span>
        <input type="text" placeholder="Search bills, orders, connections..." aria-label="Search this page" />
    </div>
    <div class="nx-top-right">
        <span class="nx-env"><i></i> Production</span>
        <span class="nx-icon-btn" title="Notifications"><span class="material-symbols-outlined">notifications</span></span>
        <span class="nx-icon-btn" title="Help"><span class="material-symbols-outlined">help</span></span>
        <div class="nx-user">
            <div class="nx-user-meta">
                <div class="nx-user-name">@(User.Identity?.Name ?? "User")</div>
                <div class="nx-user-role">Subscriber</div>
            </div>
            <span class="nx-avatar">@initials</span>
            <form asp-controller="Customer" asp-action="Logout" method="post" class="inline">
                <button type="submit" class="nx-logout">Logout</button>
            </form>
        </div>
    </div>
</header>
<aside class="nx-sidebar" id="nxSidebar">
    <div class="nx-side-title"><strong>Self-Care Console</strong><span>Subscriber services</span></div>
    <nav class="nx-nav">
        <a class="@Act("Dashboard")" asp-controller="Customer" asp-action="Dashboard"><span class="material-symbols-outlined">dashboard</span><span>Dashboard</span></a>
        <a class="@Act("MyConnections")" asp-controller="Customer" asp-action="MyConnections"><span class="material-symbols-outlined">cell_tower</span><span>My Connections</span></a>
        <a class="@Act("MyBills")" asp-controller="Customer" asp-action="MyBills"><span class="material-symbols-outlined">receipt_long</span><span>My Bills &amp; Invoices</span></a>
        <a class="@Act("ApplyConnection","SelectPlan","OrderConfirmation")" asp-controller="Customer" asp-action="ApplyConnection"><span class="material-symbols-outlined">add_circle</span><span>Apply New Connection</span></a>
        <a class="@Act("MyOrders","OrderDetails")" asp-controller="Customer" asp-action="MyOrders"><span class="material-symbols-outlined">history</span><span>Order History</span></a>
        <a class="@Act("TrackStatus")" asp-controller="Customer" asp-action="TrackStatus"><span class="material-symbols-outlined">travel_explore</span><span>Track Status</span></a>
        <a class="@Act("Feedback")" asp-controller="Customer" asp-action="Feedback"><span class="material-symbols-outlined">support_agent</span><span>Support &amp; Feedback</span></a>
        <a class="@Act("Profile","EditProfile")" asp-controller="Customer" asp-action="Profile"><span class="material-symbols-outlined">account_circle</span><span>My Profile</span></a>
    </nav>
    <div class="nx-side-bottom">
        <a asp-controller="Home" asp-action="Index"><span class="material-symbols-outlined">home</span><span>All portals</span></a>
        <button type="button" id="nxCollapse"><span class="material-symbols-outlined">keyboard_double_arrow_left</span><span class="nx-collapse-label">Collapse view</span></button>
    </div>
</aside>
<div class="nx-backdrop" id="nxBackdrop"></div>
}
else
{
<header class="nx-topbar">
    <a class="nx-brand" asp-controller="Home" asp-action="Index"><span class="material-symbols-outlined">hub</span> Nexus Telecom</a>
    <span class="nx-sub-brand">Subscriber Portal</span>
    <div class="nx-top-right">
        <a class="nx-logout" asp-controller="Customer" asp-action="Login">Login</a>
        <a class="nx-logout" asp-controller="Customer" asp-action="Register">Register</a>
    </div>
</header>
}
<div class="nx-main" style="@(loggedIn ? "" : "margin-left:0")">
    <div class="nx-crumbs">
        <a asp-controller="Home" asp-action="Index">Nexus</a><span class="sep">/</span><span>Customer Portal</span><span class="sep">/</span><b>@ViewData["Title"]</b>
    </div>
    <main class="nx-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success" data-autohide>✔ @TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">✖ @TempData["Error"]</div>
        }
        @RenderBody()
    </main>
    <footer class="nx-footer"><span>&copy; @DateTime.Now.Year Nexus Communication System</span><span>Customer Portal</span></footer>
</div>
<script src="~/js/nexus.js" asp-append-version="true"></script>
<script src="~/js/customer.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
