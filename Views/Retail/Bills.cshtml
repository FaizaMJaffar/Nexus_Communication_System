@model List<Bill>
@{
    ViewData["Title"] = "Bills";
    ViewData["Active"] = "Bills";
    string Badge(string s) => s switch
    {
        "Paid" => "badge-green",
        "Unpaid" => "badge-red",
        _ => "badge-blue"
    };
}

<div class="page-head">
    <div>
        <h1>Bills</h1>
        <p>Bills generated by Accounts for your outlet's connections (read only).</p>
    </div>
</div>

<div class="card">
    <div class="toolbar">
        <form asp-action="Bills" method="get" class="search-form">
            <input type="text" name="q" value="@ViewBag.Q" class="form-control" placeholder="Account ID, customer or status..." />
            <button type="submit" class="btn btn-primary">Search</button>
            @if (!string.IsNullOrEmpty(ViewBag.Q as string))
            {
                <a asp-action="Bills" class="btn btn-outline">Clear</a>
            }
        </form>
        <span class="count-chip">@Model.Count record(s)</span>
    </div>
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>Bill #</th><th>Account ID</th><th>Customer</th><th>Month</th><th>Due date</th><th>Total</th><th>Prev. balance</th><th>Paid</th><th>Balance</th><th>Status</th></tr></thead>
            <tbody>
            @foreach (var b in Model)
            {
                var paid = b.Payments.Sum(p => p.AmountPaid);
                <tr>
                    <td>@b.BillId</td>
                    <td>@(b.Connection?.ConnectionNumber ?? "-")</td>
                    <td>@(b.Customer?.FullName ?? "-")</td>
                    <td>@b.BillingMonth</td>
                    <td>@b.DueDate.ToString("dd MMM yyyy")</td>
                    <td>$@b.TotalAmount.ToString("N2")</td>
                    <td>$@b.PreviousBalance.ToString("N2")</td>
                    <td>$@paid.ToString("N2")</td>
                    <td>$@((b.TotalAmount - paid).ToString("N2"))</td>
                    <td><span class="badge @Badge(b.Status)">@b.Status</span></td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="10" class="empty">No bill yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
